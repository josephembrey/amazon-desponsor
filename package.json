		"@wxt-dev/auto-icons": "^1.1.1",
		"@wxt-dev/module-svelte": "^2.0.4",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"jiti": "^2.7.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
